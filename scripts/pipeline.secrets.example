# pipeline.secrets.example — template for scripts/local-pipeline.sh (and local-deploy.sh)
#
# Copy to `pipeline.secrets` (git-ignored) and fill in real values:
#     cp pipeline.secrets.example pipeline.secrets && chmod 600 pipeline.secrets
#
# FORMAT: KEY=value, one per line. The value is the LITERAL remainder of the line —
#   do NOT quote or escape it. The scripts parse this file (they no longer shell-source
#   it), so $, spaces, parentheses, quotes, and backticks in a value are all safe and are
#   NOT expanded. One optional pair of surrounding single/double quotes is stripped.
#   No `export`. No inline trailing comments (they become part of the value).
#   JSON blobs (FIREBASE_SERVICE_ACCOUNT_JSON) go on a single line.
# This .example holds NO real secrets and is safe to commit.
#
# =========================================================================
# 1) WEB DEPLOY (local-deploy.sh — beta + prod stages)
# =========================================================================
# Registry
DOCKERHUB_USERNAME=chthonicsystems
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_PACKAGES_PAT reads @chthonicsystems npm packages at Docker build time
GITHUB_PACKAGES_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public web build args (OAuth client IDs + Firebase WEB config).
# Public values; committed defaults also exist in web/scripts/native-build.sh.
REACT_APP_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
REACT_APP_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
REACT_APP_APPLE_CLIENT_ID=com.chthonicsystems.torquetech.web
REACT_APP_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
# REACT_APP_FIREBASE_VAPID_KEY is optional (web push); leave empty if unused
REACT_APP_FIREBASE_VAPID_KEY=

# =========================================================================
# 2) ANDROID (local-pipeline.sh — android stage: AAB -> Play Store + S3)
# =========================================================================
# Release upload keystore (.jks) path + credentials
KEYSTORE_PATH=/Users/you/chthonicsystems/torquetech.keystore
KEYSTORE_PASSWORD=xxxxxxxx
KEY_ALIAS=xxxxxxxx
KEY_PASSWORD=xxxxxxxx
# Google Play service-account JSON (fastlane upload_to_play_store json_key_data). Single line, no quotes.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","..."}
# AWS (AAB mirror). The android S3-mirror step is optional — it skips if AWS_S3_BUCKET_ANDROID is empty.
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_ANDROID=your-android-artifact-bucket

# =========================================================================
# 3) iOS (local-pipeline.sh — ios stage: TestFlight + App Store review)
# =========================================================================
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_API_ISSUER_ID=00000000-0000-0000-0000-000000000000
APP_STORE_CONNECT_API_KEY_PATH=/Users/you/chthonicsystems/AuthKey_XXXXXXXXXX.p8
# MATCH_PASSWORD decrypts chthonicsystems/torquetech-signing
MATCH_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# macOS local-signing seed: security import rejects match's empty-password p12, so the
# pipeline pre-imports this known-password p12 into a temp keychain before match/gym.
IOS_SIGNING_P12_PATH=/Users/you/chthonicsystems/distribution.p12
IOS_SIGNING_P12_PASSWORD=xxxxxxxx
